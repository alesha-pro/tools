+def track_beats(drums, mix, sr, duration, bpm0=133.0):
+    """Variable-tempo beat grid (Suno tracks drift: here ~133 -> 137.7 BPM).
+    Phase-locked loop on a drum+mix onset envelope: each beat is searched near
+    its prediction (Gaussian prior, sd 25 ms), the period follows slowly; then
+    beat times are smoothed (local quadratic fit over +-8 beats) so the grid is
+    free of per-beat jitter but follows the tempo curve."""
+    from scipy.signal import savgol_filter
+    hop = 64
+    od = librosa.onset.onset_strength(y=librosa.resample(drums, orig_sr=sr, target_sr=22050),
+                                      sr=22050, hop_length=hop // 2, lag=1, max_size=1)
+    om = librosa.onset.onset_strength(y=librosa.resample(mix, orig_sr=sr, target_sr=22050),
+                                      sr=22050, hop_length=hop // 2, lag=1, max_size=1)
+    o = od / (np.percentile(od, 99) + 1e-9) + 0.5 * om / (np.percentile(om, 99) + 1e-9)
+    ofps = 22050 / (hop // 2)
+    P = 60 / bpm0
+    # initial phase: best offset over the first 12 s at bpm0
+    best = (-1, 0.0)
+    for off in np.arange(0, P, 0.002):
+        idx = (np.arange(off, 12, P) * ofps).astype(int)
+        sc = o[idx].mean()
+        if sc > best[0]:
+            best = (sc, off)
+    beats = [best[1]]
+    while beats[-1] + P < duration - 0.05:
+        pred = beats[-1] + P
+        a, b = int((pred - 0.07) * ofps), int((pred + 0.07) * ofps)
+        tt = np.arange(a, b) / ofps
+        w = o[a:b] * np.exp(-0.5 * ((tt - pred) / 0.025) ** 2)
+        if w.max() > 0.15 * np.percentile(o, 95):
+            t = float(tt[np.argmax(w)])
+            P = 0.92 * P + 0.08 * (t - beats[-1])
+        else:
+            t = pred
+        beats.append(t)
+    beats = np.array(beats)
+    idx = np.arange(len(beats))
+    sm = savgol_filter(beats, 17, 2)
+    # phase: the envelope locks onto whichever 8th-note grid is strongest (the
+    # off-beat hats here). Re-phase on kick attacks: shift every beat by the
+    # median kick phase (fraction of the local inter-beat interval).
+    kick_t, _ = band_onsets(drums, sr, None, 120, win=0.012, min_gap=0.2, rel_db=12)
+    ib = np.interp(kick_t, sm, np.arange(len(sm)))
+    ok = (ib > 0) & (ib < len(sm) - 1)
+    ph = np.angle(np.mean(np.exp(2j * np.pi * ib[ok]))) / (2 * np.pi)   # circular mean, -0.5..0.5
+    ibi = np.gradient(sm)
+    sm = sm + ph * ibi
+    print(f"kick phase shift {ph:+.3f} beat")
+    return sm
+
